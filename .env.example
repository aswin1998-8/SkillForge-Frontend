NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Same OAuth client ID as backend GOOGLE_CLIENT_ID (Web application type)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Cloud Console checklist (Sign in with Google for everyone):
# 1. APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# 2. Authorized JavaScript origins MUST include every frontend URL users open:
#      http://localhost:3000
#      https://your-app.vercel.app
#    (Preview URLs like https://*.vercel.app need listing or will fail for those links)
# 3. OAuth consent screen → Publishing status: set to "In production" (External)
#    If left on "Testing", only listed test users (or basic sign-in exceptions) work.
# 4. Vercel env: NEXT_PUBLIC_GOOGLE_CLIENT_ID=<same client id>
# 5. Render env: GOOGLE_CLIENT_ID=<same client id>
# 6. CORS_ALLOWED_ORIGINS / CSRF_TRUSTED_ORIGINS must include the Vercel origin
